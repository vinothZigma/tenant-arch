# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
DJANGO_ENV=development

# Master DB (the company DBs copy these settings, only the name differs)
DB_ENGINE=django.db.backends.mysql
DB_NAME=iwmsTenant
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# SQLite fallback for local dev: DB_ENGINE=django.db.backends.sqlite3

# Multi-tenancy (helpDoc/14-multi-tenancy.md)
TENANCY_MODE=per_db
TENANT_DB_PREFIX=iwms_company_
DEVELOPER_USERNAME=developer
DEVELOPER_PASSWORD=
TENANCY_CURRENCY=₹

# Web auth cookies (set true behind HTTPS)
AUTH_COOKIE_SECURE=false

# Email / OTP / external APIs: see config/settings.py for the full list
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
ORS_API_KEY=
